{
  "name": "cesiumjs-copc-core",
  "version": "0.1.2",
  "description": "COPC hierarchy, byte-range loading, caches, and decoded point types",
  "keywords": [
    "copc",
    "point-cloud",
    "lidar",
    "range-request",
    "geospatial"
  ],
  "homepage": "https://github.com/yangseungsang/cesiumjs-copc-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangseungsang/cesiumjs-copc-runtime.git",
    "directory": "packages/copc-core"
  },
  "bugs": {
    "url": "https://github.com/yangseungsang/cesiumjs-copc-runtime/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "third_party",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "copc": "^0.0.9"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5"
  }
}
