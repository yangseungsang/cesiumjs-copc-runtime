{
  "name": "cesiumjs-copc",
  "version": "0.1.1",
  "description": "Stream and render COPC point clouds directly in CesiumJS",
  "keywords": [
    "cesiumjs",
    "copc",
    "point-cloud",
    "lidar",
    "webgl",
    "geospatial"
  ],
  "homepage": "https://yangseungsang.github.io/cesiumjs-copc-runtime/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangseungsang/cesiumjs-copc-runtime.git",
    "directory": "packages/cesium-copc"
  },
  "bugs": {
    "url": "https://github.com/yangseungsang/cesiumjs-copc-runtime/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "cesiumjs-copc-core": "0.1.0",
    "cesiumjs-copc-runtime": "0.1.0",
    "cesiumjs-copc-worker": "0.1.0",
    "egm96-universal": "^1.1.1",
    "proj4": "^2.19.10"
  },
  "peerDependencies": {
    "cesium": "^1.144.0"
  },
  "devDependencies": {
    "cesium": "^1.144.0"
  }
}
